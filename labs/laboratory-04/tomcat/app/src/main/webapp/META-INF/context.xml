<Context>
  <Resource
    name="jdbc/laboratoryDB"
    auth="Container"
    type="javax.sql.DataSource"
    driverClassName="org.postgresql.Driver"
    url="jdbc:postgresql://postgres:5432/laboratory_bd"
    username="${DB_USER}"
    password="${DB_PASSWORD}"
    maxActive="20"
    maxIdle="10"
    maxWait="1000"
  />
</Context>

